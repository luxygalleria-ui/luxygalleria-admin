# Public build-time values for production builds (Vercel). Committed on purpose: no secrets here.
# A Vercel project env var with the same name overrides these; .env (local, never committed) wins on a dev machine.
NEXT_PUBLIC_API_URL=https://api.luxygalleria.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://api.luxygalleria.com/api/v1
